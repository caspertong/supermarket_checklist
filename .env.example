# Neon connection string from the Vercel Neon integration.
# Leave unset on your own machine to use a local database in .data/pglite.
DATABASE_URL=

# Required in production. Generated automatically for local development.
AUTH_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:family@example.com

# Required in production for /api/promotions/refresh (Vercel cron sends Bearer token).
CRON_SECRET=
